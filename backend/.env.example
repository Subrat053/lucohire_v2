# Copy this file to .env and fill in your values.

PORT=5000
NODE_ENV=development
# Prisma/PostgreSQL. Change only this value between Neon and the VPS.
# Neon development example:
DATABASE_URL="postgresql://USER:PASSWORD@HOST/dbname?sslmode=require"
# VPS production example:
# DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/dbname"

JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRE=7d
ADMIN_EMAIL=admin@yourdomain.com
ENCRYPTION_SECRET=change_this_to_a_random_encryption_secret

# ─── CORS ─────────────────────────────────────────────────────────────────────
# URL of your deployed frontend (Vercel / Netlify / custom domain)
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,https://yourdomain.com

# ─── Business Logic ───────────────────────────────────────────────────────────
FREE_SKILLS_LIMIT=4
FREE_PROFILE_VIEW_LIMIT=10
ROTATION_POOL_SIZE=5
ROTATION_INTERVAL_SEC=60
FEATURED_LIMIT=5
SEARCH_RADIUS_KM=50
PROFILE_VALIDITY_DAYS=365

# ─── Exchange Rates & Geo ─────────────────────────────────────────────────────
# Currency conversion uses exchangerate-api USD base and derives INR pairs.
EXCHANGE_RATE_API_URL=https://api.exchangerate-api.com/v4/latest/USD
EXCHANGE_RATE_CACHE_TTL_MS=3600000
# Geoapify (Location autocomplete + nearby places)
GEOAPIFY_API_KEY=your_geoapify_api_key

# Number of trusted proxy hops for Express (0 for local/no proxy)
TRUST_PROXY_HOPS=0

# Google Places API (Location autocomplete + details)
# Note: Restrict backend key by IP address or specific backend allowed APIs only.
GOOGLE_PLACES_API_KEY=your_google_places_api_key
GOOGLE_API_KEY=your_google_api_key

# ─── Google OAuth ───────────────────────────────────────────────────────────────
# Create credentials at https://console.cloud.google.com/ → APIs & Services → Credentials
# Add your backend domain to Authorized JavaScript origins and redirect URIs.
GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret

# ─── Email (SMTP / Transactional Provider) ───────────────────────────────────
# Works with Gmail SMTP, SendGrid SMTP relay, Mailgun SMTP, Brevo SMTP, etc.
SMTP_HOST=smtp.your-provider.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_smtp_username
SMTP_PASS=your_smtp_password
EMAIL_FROM=no-reply@yourdomain.com
EMAIL_FROM_NAME=ServiceHub
EMAIL_OTP_VALIDITY_MINUTES=10

# ─── Resend (Email OTP for international users) ───────────────────────────────
RESEND_API_KEY=your_resend_api_key
RESEND_FROM_EMAIL=noreply@yourdomain.com

# ─── OTP Configuration ────────────────────────────────────────────────────────
OTP_EXPIRY_MINUTES=5
OTP_MAX_ATTEMPTS=5
OTP_RESEND_LIMIT=3
OTP_BLOCK_MINUTES=15
OTP_SESSION_MINUTES=30

# ─── WhatsApp Business API (Meta Cloud API) ───────────────────────────────────
WHATSAPP_PHONE_NUMBER_ID=your_whatsapp_phone_number_id
WHATSAPP_ACCESS_TOKEN=your_whatsapp_access_token
WHATSAPP_OTP_TEMPLATE_NAME=your_otp_template_name
WHATSAPP_OTP_TEMPLATE_LANG=en
WHATSAPP_WELCOME_TEMPLATE_NAME=your_welcome_template_name
WHATSAPP_DEV_MODE=false

# ─── WhatsApp Cloud API (For Bulk Outreach) ──────────────────────────────────
META_WHATSAPP_TOKEN=your_meta_token_here
META_PHONE_NUMBER_ID=your_phone_id_here

# ─── Razorpay ─────────────────────────────────────────────────────────────────
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# ─── Stripe ───────────────────────────────────────────────────────────────────
STRIPE_PUBLISHABLE_KEY=pk_live_...
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...

# ─── Firebase Admin & Web Config ──────────────────────────────────────────────
FIREBASE_PROJECT_ID=your_firebase_project_id
FIREBASE_CLIENT_EMAIL=your_firebase_client_email
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nyour_private_key\n-----END PRIVATE KEY-----\n"
FIREBASE_WEB_API_KEY=your_firebase_web_api_key

# ─── Google Cloud Translation & Vision ────────────────────────────────────────
GOOGLE_TRANSLATE_API_KEY=your_google_translate_api_key
GOOGLE_PROJECT_ID=your_google_project_id
TRANSLATE_RATE_LIMIT_WINDOW_MS=60000
TRANSLATE_RATE_LIMIT_MAX=60
GOOGLE_VISION_API_KEY=your_api_key_here
VISION_UPLOAD_MAX_BYTES=10485760

# ─── External Job Search APIs ─────────────────────────────────────────────────
ADZUNA_APP_ID=your_adzuna_app_id
ADZUNA_APP_KEY=your_adzuna_app_key
JOOBLE_API_KEY=your_jooble_api_key
RAPIDAPI_KEY=your_rapidapi_key
INDEED_RAPIDAPI_KEY=your_indeed_rapidapi_key

# ─── Gemini AI (Resume Parser) ────────────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key
GEMINI_RESUME_MODEL=gemini-1.5-flash-latest

# ─── AI: Anthropic Claude ────────────────────────────────────────────────────
ANTHROPIC_API_KEY=your_anthropic_api_key
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
ANTHROPIC_TIMEOUT_MS=15000
ANTHROPIC_MAX_RETRIES=2
ANTHROPIC_INPUT_USD_PER_MTOK=3
ANTHROPIC_OUTPUT_USD_PER_MTOK=15

# ─── AI: OpenAI Embeddings ───────────────────────────────────────────────────
OPENAI_API_KEY=your_openai_api_key
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_TIMEOUT_MS=12000
OPENAI_EMBEDDING_USD_PER_MTOK=0.02

# ─── AI Feature Switches & Security ──────────────────────────────────────────
AI_FEATURES_ENABLED=false
AI_CHAT_ENABLED=false
AI_PROFILE_ENABLED=false
AI_EMBEDDINGS_ENABLED=false
AI_OCR_ENABLED=false
ENABLE_RESUME_AI=false
ENABLE_RESUME_OCR=false
AI_FRAUD_ENABLED=false
AI_RATE_LIMIT_WINDOW_MS=60000
AI_RATE_LIMIT_MAX=20
FEATURE_FLAG_CACHE_MS=30000

# ─── Queue / Redis / Upstash / Workers ───────────────────────────────────────
ENABLE_WORKERS=false
ENABLE_CRON=false
ENABLE_CRAWLERS=false
ENABLE_OUTREACH=false
ENABLE_RECRUITER_MATCHING=false
ENABLE_RECRUITER_AI=false
ENABLE_PROVIDER_AI_INSIGHTS=false
ENABLE_PROVIDER_AI_JOBS=false
ENABLE_PROVIDER_RESUME_AUTOGENERATION=false
ENABLE_PROVIDER_DOCUMENT_VERIFICATION=false
ENABLE_EXTERNAL_PROFILE_ASSETS=false
ENABLE_COMMUNICATION_PROVIDERS=false
ENABLE_PAYMENT_PROVIDERS=false
ENABLE_WEBHOOKS=false
ENABLE_WAGE_AI=false
ENABLE_SEO_AUTOMATION=false
ENABLE_JOB_AI_EXPIRY=false
ENABLE_JOB_AI_MATCHING=false
ENABLE_EXTERNAL_LOCATION_LOOKUPS=false
ENABLE_LEAD_DISTRIBUTION=false
ENABLE_SYNC_ENGINE=false
ENABLE_CONNECTORS=false
ENABLE_PIPELINE_JOBS=false
ENABLE_SELF_HEALING=false
REDIS_URL=redis://localhost:6379
REDIS_TLS=false
REDIS_TLS_REJECT_UNAUTHORIZED=true
QUEUE_USE_BULLMQ=false
QUEUE_DEFAULT_ATTEMPTS=3
QUEUE_DEFAULT_BACKOFF_MS=2000
WORKER_CONCURRENCY=5
UPSTASH_REDIS_REST_URL=https://your-upstash-redis-rest-url.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_redis_rest_token

# ─── Apify Scraper Engine ─────────────────────────────────────────────────────
APIFY_API_TOKEN=your_apify_api_token
APIFY_NAUKRI_ACTOR_ID=muhammetakkurtt/naukri-job-scraper

# ─── Cloudinary (optional) ───────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# ─── Trust / Fraud / Demand ──────────────────────────────────────────────────
FRAUD_IP_ACCOUNT_THRESHOLD=3
DEMAND_SPIKE_MIN_SCORE=3

# ─── Additional Worker & App Defaults ───────────────────────────────────────
VITE_APP_URL=http://localhost:5173
APP_NAME=Lucohire

