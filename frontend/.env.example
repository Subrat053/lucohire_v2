# Copy this file to .env (for local dev) or set these vars in your hosting dashboard.
#
# ─── Backend API URL ──────────────────────────────────────────────────────────
# Point this to wherever your Node/Express backend is deployed.
# Examples:
#   Local dev  → http://localhost:5000/api
#   Render     → https://servicehub-api.onrender.com/api
#   Railway    → https://servicehub-api.up.railway.app/api
#   Custom     → https://api.yourdomain.com/api
VITE_API_URL=http://localhost:5000/api
VITE_AUTH_URL=http://localhost:5000/api/v1
VITE_ADMIN_API_URL=http://localhost:5000/api/v1

# ─── Google OAuth ──────────────────────────────────────────────────────────────
VITE_GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com

# ─── Stripe ───────────────────────────────────────────────────────────────────
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key

# ─── Firebase Configuration ───────────────────────────────────────────────────
VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_firebase_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_firebase_app_id

# ─── Google Places API ────────────────────────────────────────────────────────
# Restrict this browser-facing API key by HTTP referrer (allowed domain)
# and enable ONLY the Places API in the Google Cloud Console.
VITE_GOOGLE_PLACES_API_KEY=your_google_places_api_key

# ─── Site Metadata & WebSockets ────────────────────────────────────────────────
VITE_SITE_URL=https://www.lucohire.com
VITE_SOCKET_URL=http://localhost:5000

